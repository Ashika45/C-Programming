#include <stdio.h>

int main()
{
    int t,s,r,n;
    printf("Enter the number to be checked : ");
    scanf("%d",&n);
    t=n;
    s=0;
    while(n>0)
        {
            r=n%10;
            s=s+(r*r*r);
            n=n/10;
        }
    if(s==t)
        {
        printf("The given number is amstrong");
        }
    else
    {
        printf("The given number is not amstrong");
    }
}
