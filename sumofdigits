#include <stdio.h>

int main() 
{
    int n, r, sum = 0;
    
    printf("Enter the number : ");
    scanf("%d", &n);
    
    // Loop continues until all digits are extracted and n becomes 0
    while (n != 0) 
    {
        r = n % 10;   // Extract the last digit
        sum = sum + r; // Add it to the sum
        n = n / 10;   // Remove the last digit
    }
    
    printf("\nSum of digits: %d\n", sum);
    
    return 0; // Good practice to return 0 in main
}
